{
  "name": "turnstile",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @turnstile/web build",
    "test": "tsc -b && tsc -p tsconfig.test.json && vitest run",
    "lint": "eslint . --max-warnings 0 && node scripts/check-no-emoji.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "tsc -b --clean",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
